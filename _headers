# Netlify Cache-Control Headers
# Long-lived caching for static assets (1 year)
# Short-lived caching for HTML pages (1 hour)

# CSS — 1 year immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable

# JavaScript — 1 year immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images — 1 year immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

# AI Center assets
/ai/js/*
  Cache-Control: public, max-age=31536000, immutable

# Industries assets
/industries/js/*
  Cache-Control: public, max-age=31536000, immutable

# Compare assets
/compare/js/*
  Cache-Control: public, max-age=31536000, immutable

# PDF tools assets
/pdf-tools/js/*
  Cache-Control: public, max-age=31536000, immutable

# Tools assets
/tools/js/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — 1 hour, must-revalidate
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Sitemap — 1 hour
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate

# Robots — 1 hour
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

# Reports — no cache (internal)
/reports/*
  Cache-Control: no-store

# Security headers for all responses
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
